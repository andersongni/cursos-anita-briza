generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  hours       Int      @default(40)
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  enrollments  CourseEnrollment[]
  dimensions   Dimension[]
  questions    Question[]
  assessments  Assessment[]
  certificates Certificate[]
  releases     AttemptRelease[]
}

model CourseEnrollment {
  id          String   @id @default(cuid())
  student_id  String
  course_id   String
  status      String   @default("ACTIVE")
  enrolled_at DateTime @default(now())

  student Profile @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([student_id, course_id])
  @@index([course_id])
  @@index([student_id])
}

model Profile {
  id            String    @id @default(cuid())
  username      String    @unique
  full_name     String
  email         String?
  phone         String?
  role          String    @default("STUDENT")
  status        String    @default("PENDING")
  password_hash   String
  session_version Int       @default(0)
  must_change_password Boolean  @default(false)
  last_login_at   DateTime?
  /** Soft-delete: preenchido quando o admin exclui o aluno (restaurável).
   *  Ao adicionar campos novos, registre o ALTER em src/lib/schema-migrations.ts
   *  (aplicado automaticamente no `npm run build` / deploy Vercel). */
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  assessments      Assessment[]
  enrollments      CourseEnrollment[]
  releasesGiven    AttemptRelease[] @relation("ReleasedBy")
  releasesReceived AttemptRelease[] @relation("Student")
  certificates     Certificate[]
  auditLogs        AuditLog[]
  settingsUpdated  SystemSetting[]
  feedbacks        Feedback[]
  typingAttempts   TypingAttempt[]
}

model Dimension {
  id                String   @id @default(cuid())
  course_id         String
  name              String
  description       String?
  weight            Int      @default(1)
  display_order     Int      @default(0)
  target_percentage Float    @default(5.0)
  active            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  course              Course               @relation(fields: [course_id], references: [id])
  questions           Question[]
  assessmentQuestions AssessmentQuestion[]

  @@index([course_id])
}

model Question {
  id              String   @id @default(cuid())
  course_id       String
  type            String
  /// MULTIPLE_CHOICE | DISCURSIVE
  format          String   @default("MULTIPLE_CHOICE")
  dimension_id    String
  question_text   String
  /// Critérios / exemplos aceitos para correção de discursivas
  expected_answer String?
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  course              Course               @relation(fields: [course_id], references: [id])
  dimension           Dimension            @relation(fields: [dimension_id], references: [id])
  options             QuestionOption[]
  assessmentQuestions AssessmentQuestion[]

  @@index([course_id])
}

model QuestionOption {
  id          String  @id @default(cuid())
  question_id String
  option_key  String
  option_text String
  is_correct  Boolean @default(false)
  explanation String

  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
}

model Assessment {
  id               String    @id @default(cuid())
  student_id       String
  course_id        String
  type             String
  status           String    @default("IN_PROGRESS")
  attempt_number   Int       @default(1)
  started_at       DateTime  @default(now())
  deadline_at      DateTime
  completed_at     DateTime?
  duration_seconds Int?
  total_questions  Int
  score            Float?
  correct_count    Int?
  wrong_count      Int?
  passed           Boolean?
  created_at       DateTime  @default(now())

  student     Profile              @relation(fields: [student_id], references: [id])
  course      Course               @relation(fields: [course_id], references: [id])
  questions   AssessmentQuestion[]
  answers     AssessmentAnswer[]
  certificate Certificate?
  releases    AttemptRelease[]

  @@index([course_id])
  @@index([student_id, course_id])
}

model AssessmentQuestion {
  id                         String  @id @default(cuid())
  assessment_id              String
  question_id                String?
  question_order             Int
  dimension_id               String?
  dimension_name_snapshot    String
  question_text_snapshot     String
  /// MULTIPLE_CHOICE | DISCURSIVE
  format                     String  @default("MULTIPLE_CHOICE")
  expected_answer_snapshot   String  @default("")
  option_a_text              String  @default("")
  option_b_text              String  @default("")
  option_c_text              String  @default("")
  option_d_text              String  @default("")
  option_e_text              String  @default("")
  option_a_explanation       String  @default("")
  option_b_explanation       String  @default("")
  option_c_explanation       String  @default("")
  option_d_explanation       String  @default("")
  option_e_explanation       String  @default("")
  correct_option             String  @default("")

  assessment Assessment         @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  question   Question?          @relation(fields: [question_id], references: [id])
  dimension  Dimension?         @relation(fields: [dimension_id], references: [id])
  answers    AssessmentAnswer[]
}

model AssessmentAnswer {
  id                     String    @id @default(cuid())
  assessment_id          String
  assessment_question_id String
  selected_option        String?
  text_answer            String?
  /// 0–100 para a questão (discursiva ou MC convertida)
  score_percent          Float?
  grading_feedback       String?
  is_correct             Boolean?
  answered_at            DateTime?
  flagged_for_review     Boolean   @default(false)

  assessment         Assessment         @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  assessmentQuestion AssessmentQuestion @relation(fields: [assessment_question_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, assessment_question_id])
}

model AttemptRelease {
  id            String    @id @default(cuid())
  student_id    String
  course_id     String
  released_by   String
  reason        String?
  used          Boolean   @default(false)
  cancelled     Boolean   @default(false)
  assessment_id String?
  created_at    DateTime  @default(now())

  student    Profile     @relation("Student", fields: [student_id], references: [id])
  course     Course      @relation(fields: [course_id], references: [id])
  releasedBy Profile     @relation("ReleasedBy", fields: [released_by], references: [id])
  assessment Assessment? @relation(fields: [assessment_id], references: [id])

  @@index([course_id])
}

model Certificate {
  id                    String   @id @default(cuid())
  student_id            String
  course_id             String
  assessment_id         String   @unique
  certificate_code      String   @unique
  student_name_snapshot String
  course_name_snapshot  String
  completion_date       DateTime
  score_snapshot        Float?
  template_version      Int      @default(1)
  pdf_path              String?
  created_at            DateTime @default(now())

  student    Profile    @relation(fields: [student_id], references: [id])
  course     Course     @relation(fields: [course_id], references: [id])
  assessment Assessment @relation(fields: [assessment_id], references: [id])

  @@index([course_id])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updated_at  DateTime @updatedAt
  updated_by  String?

  updatedBy Profile? @relation(fields: [updated_by], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  user_id     String?
  action      String
  entity_type String
  entity_id   String?
  metadata    String?
  created_at  DateTime @default(now())

  user Profile? @relation(fields: [user_id], references: [id])
}

model Feedback {
  id         String   @id @default(cuid())
  user_id    String
  role       String
  subject    String?
  message    String
  created_at DateTime @default(now())

  user Profile @relation(fields: [user_id], references: [id])
}

/** Textos para o exercício de digitação (CRUD só admin). */
model TypingPassage {
  id         String   @id @default(cuid())
  title      String
  content    String
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  attempts TypingAttempt[]
}

/** Tentativa concluída de digitação por um aluno. */
model TypingAttempt {
  id            String   @id @default(cuid())
  student_id    String
  passage_id    String
  duration_ms   Int
  error_count   Int
  chars_total   Int
  wpm           Float
  accuracy      Float
  score         Float
  completed_at  DateTime @default(now())
  created_at    DateTime @default(now())

  student Profile       @relation(fields: [student_id], references: [id])
  passage TypingPassage @relation(fields: [passage_id], references: [id])

  @@index([passage_id, duration_ms])
  @@index([student_id, passage_id])
}
