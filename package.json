{
  "name": "avaliacao-anita-briza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "seed": "npx tsx scripts/seed-questions.ts",
    "seed:settings": "npx tsx scripts/seed-settings.ts",
    "create-admin": "npx tsx scripts/create-admin.ts",
    "ensure-admin": "npx tsx scripts/ensure-admin.ts",
    "db:push": "npx prisma db push",
    "db:setup": "npx prisma db push && npm run seed:settings && npm run ensure-admin",
    "db:setup:remote": "npx tsx scripts/setup-remote.ts",
    "db:reset": "npx prisma db push --force-reset && npm run seed:settings && npm run ensure-admin",
    "db:clear": "npx tsx scripts/clear-data.ts && npm run seed:settings && npm run ensure-admin",
    "db:group-dimensions": "npx tsx scripts/group-dimensions.ts",
    "db:studio": "npx prisma studio",
    "setup": "npm run db:setup"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "prisma": "^7.10.0",
    "react": "19.2.8",
