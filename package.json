{
  "name": "cursos-anita-briza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:raw": "next dev",
    "build": "prisma generate && npx tsx scripts/deploy-schema.ts && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "seed": "npx tsx scripts/seed-questions.ts",
    "seed:prova-oficial": "npx tsx scripts/apply-prova-oficial-informatica.ts",
    "seed:prova-oficial:remote": "npx tsx scripts/apply-prova-oficial-informatica.ts --remote",
    "seed:eletrica": "npx tsx scripts/seed-eletrica-questions.ts",
    "seed:typing": "npx tsx scripts/seed-typing-passages.ts",
    "seed:typing:remote": "npx tsx scripts/seed-typing-passages.ts --remote",
    "seed:settings": "npx tsx scripts/seed-settings.ts",
    "create-admin": "npx tsx scripts/create-admin.ts",
    "ensure-admin": "npx tsx scripts/ensure-admin.ts",
    "db:push": "npx prisma db push",
    "db:setup": "npx prisma db push && npm run seed:settings && npm run seed:typing && npm run ensure-admin",
    "db:setup:remote": "npx tsx scripts/setup-remote.ts",
    "db:migrate": "npx tsx scripts/deploy-schema.ts",
    "db:reset-password": "npx tsx scripts/reset-local-password.ts",
    "db:reset": "npx prisma db push --force-reset && npm run seed:settings && npm run ensure-admin",
    "db:clear": "npx tsx scripts/clear-data.ts && npm run seed:settings && npm run ensure-admin",
    "db:studio": "npx prisma studio",
    "setup": "npm run db:setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.49.0",
    "next": "16.4.6",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2",
    "dompurify": "^3.4.17",
    "fast-uri": "^3.1.9",
    "qs": "^6.17.1",
    "minimatch@9": "11.0.7",
    "minimatch@10": "11.0.7",
    "minimatch@11": "11.0.7",
    "tinypool": "^2.2.0",
    "zod": "^4.6.6"
  }
}
