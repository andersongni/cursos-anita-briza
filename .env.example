# ── Modo OFFLINE (SQLite + JWT) ───────────────────────────────────────────────
# Não é necessário Supabase. O banco é um arquivo local SQLite.

# Caminho do banco SQLite (relativo à raiz do projeto)
DATABASE_URL="file:./prisma/dev.db"

# Segredo JWT (troque em produção por algo longo e aleatório)
JWT_SECRET=troque-por-string-aleatoria-longa

# URL da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin criado automaticamente por `npm run setup` / `ensure-admin` (opcional)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# ADMIN_FULL_NAME=Administrador
