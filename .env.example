# ── Local / offline (SQLite arquivo) ─────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── Produção (Turso + Vercel) ─────────────────────────────────────────────────
# DATABASE_URL="libsql://seu-banco-usuario.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."
# (alternativa) TURSO_DATABASE_URL="libsql://seu-banco-usuario.turso.io"

# Segredo JWT (obrigatório em produção — use string longa e aleatória)
JWT_SECRET=troque-por-string-aleatoria-longa

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google reCAPTCHA v2 (checkbox "Não sou um robô") — após 3 logins falhos
# Crie em https://www.google.com/recaptcha/admin (tipo: reCAPTCHA v2 → "I'm not a robot")
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=sua_site_key
# RECAPTCHA_SECRET_KEY=sua_secret_key
# Sem essas chaves, o sistema usa um captcha matemático local como fallback.

# Admin criado por `npm run setup` / `ensure-admin` (opcional)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# ADMIN_FULL_NAME=Administrador
